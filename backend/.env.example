# ==============================================================================
# AarogyaMitra Kiosk - Environment Configuration
# ==============================================================================

# Project & Debug
PROJECT_NAME="AarogyaMitra Kiosk API"
DEBUG=True

# Database (PostgreSQL or local SQLite)
DATABASE_URL="sqlite:///./aarogyamitra.db"

# JWT Token Security
JWT_SECRET="aarogya-mitra-secret-key-2026"
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=30

# ==============================================================================
# REAL SMS / OTP GATEWAYS
# ==============================================================================
# 1. Fast2SMS (Quick Indian SMS Gateway: https://www.fast2sms.com)
FAST2SMS_API_KEY=""

# 2. Twilio SMS Gateway (https://www.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# 3. 2Factor.in Gateway (https://2factor.in)
TWOFACTOR_API_KEY=""

# Note: If no SMS keys are configured, AarogyaMitra runs in resilient terminal
# simulation mode, printing OTPs to console and providing "123456" for instant demoing.

# ==============================================================================
# AI & TRANSLATION APIS
# ==============================================================================
GROQ_API_KEY=""
OPENAI_API_KEY=""
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
BHASHINI_PIPELINE_ID=""
